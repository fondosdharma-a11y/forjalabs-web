"btn_ant":"\u041e\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0430\u0432\u0430\u043d\u0441","btn_ant2":"\u041e\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0430\u0432\u0430\u043d\u0441","btn_ant3":"\u041e\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0430\u0432\u0430\u043d\u0441","btn_sus":"\u041f\u043e\u0434\u043f\u0438\u0441\u0430\u0442\u044c\u0441\u044f","btn_sus2":"\u041f\u043e\u0434\u043f\u0438\u0441\u0430\u0442\u044c\u0441\u044f",
"c_pie":"\u0426\u0435\u043d\u044b \u2014 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u044b\u0435 \u0438 \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0435. \u0415\u0441\u043b\u0438 \u043f\u0440\u043e\u0435\u043a\u0442 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435\u0433\u043e, \u043c\u044b \u0441\u043a\u0430\u0436\u0435\u043c \u0434\u043e \u0441\u0447\u0451\u0442\u0430, \u0430 \u043d\u0435 \u043f\u043e\u0441\u043b\u0435. \u041a\u043e\u043c\u0438\u0441\u0441\u0438\u044f Stripe \u043f\u043b\u0430\u0442\u0438\u0442\u0441\u044f \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e Stripe.",
"q_t":"\u0427\u0430\u0441\u0442\u044b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b",
"q_l":"<details><summary>\u0421\u043a\u0438\u0434\u043a\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0430\u044f?</summary><p>\u0414\u0430. Forja Labs \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u0435\u0442 \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0433\u0440\u0430\u0444\u0438\u043a \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043a\u043b\u0438\u0435\u043d\u0442\u0430\u043c\u0438. \u041f\u043e\u043b\u043e\u0432\u0438\u043d\u0430 \u0446\u0435\u043d\u044b \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438, \u0430 \u043d\u0435 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e\u0439 \u043f\u043b\u0430\u0442\u044b, \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0434\u043e 16 \u043c\u0430\u0440\u0442\u0430 2027 \u0433\u043e\u0434\u0430.</p></details><details><summary>\u041c\u043e\u0439 \u0431\u0438\u0437\u043d\u0435\u0441 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439?</summary><p>\u0415\u0441\u043b\u0438 \u0432\u0430\u043c \u0443\u0436\u0435 \u043f\u0438\u0448\u0443\u0442 \u043a\u043b\u0438\u0435\u043d\u0442\u044b \u2014 \u043d\u0435\u0442. \u0427\u0435\u043c \u043c\u0435\u043d\u044c\u0448\u0435 \u043a\u043e\u043c\u0430\u043d\u0434\u0430, \u0442\u0435\u043c \u0434\u043e\u0440\u043e\u0436\u0435 \u043a\u0430\u0436\u0434\u043e\u0435 \u0431\u0435\u0437 \u043e\u0442\u0432\u0435\u0442\u0430 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435.</p></details><details><summary>\u041d\u0443\u0436\u043d\u043e \u043b\u0438 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044c\u0441\u044f \u0432 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u0445?</summary><p>\u041d\u0435\u0442. \u0412\u044b \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0435 \u043e \u0431\u0438\u0437\u043d\u0435\u0441\u0435 \u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0435 \u0440\u0430\u0431\u043e\u0442\u0443. \u041e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u0434\u0435\u043b\u0430\u0435\u043c \u043c\u044b \u0438 \u0434\u0430\u0451\u043c \u043f\u0440\u043e\u0441\u0442\u0443\u044e \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044e.</p></details><details><summary>\u041a\u0443\u0434\u0430 \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u044e\u0442 \u0434\u0435\u043d\u044c\u0433\u0438 \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432?</summary><p>\u041d\u0430 \u0432\u0430\u0448 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u0447\u0451\u0442 Stripe, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0439 \u0441 \u0431\u0430\u043d\u043a\u043e\u043c. Forja Labs \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u0432\u0430\u0448\u0438\u0445 \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439.</p></details><details><summary>\u041c\u043e\u0436\u0435\u0442 \u043b\u0438 \u0430\u0433\u0435\u043d\u0442 \u0432\u044b\u0434\u0443\u043c\u044b\u0432\u0430\u0442\u044c?</summary><p>\u041e\u043d \u043e\u0431\u0443\u0447\u0435\u043d \u043d\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u0432\u0430\u0448\u0435\u0433\u043e \u0431\u0438\u0437\u043d\u0435\u0441\u0430 \u0438 \u0437\u043d\u0430\u0435\u0442, \u0447\u0435\u0433\u043e \u043e\u0442\u0432\u0435\u0447\u0430\u0442\u044c \u043d\u0435\u043b\u044c\u0437\u044f. \u0415\u0441\u043b\u0438 \u043d\u0435 \u0437\u043d\u0430\u0435\u0442 \u2014 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e\u0431 \u044d\u0442\u043e\u043c \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0434\u0438\u0430\u043b\u043e\u0433 \u0432\u0430\u043c. \u0412\u044b \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0435 \u043e\u0442\u0432\u0435\u0442\u044b \u0434\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430.</p></details><details><summary>\u041d\u0435 \u043e\u0442\u043f\u0443\u0433\u043d\u0451\u0442 \u043b\u0438 \u0430\u0433\u0435\u043d\u0442 \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432?</summary><p>\u041e\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u043e\u043c \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0432\u044b\u0434\u0430\u0451\u0442 \u0441\u0435\u0431\u044f \u0437\u0430 \u0432\u0430\u0441, \u0430 \u043f\u0440\u0438 \u0436\u0430\u043b\u043e\u0431\u0435 \u0438\u043b\u0438 \u0442\u043e\u0440\u0433\u0435 \u0441\u0440\u0430\u0437\u0443 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440. \u0420\u0435\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u0430 \u2014 \u043d\u0435 \u0432\u044b, \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0449\u0438\u0439 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u043e, \u0430 \u043d\u0438\u043a\u0442\u043e.</p></details><details><summary>\u041f\u043e\u0447\u0435\u043c\u0443 \u0443 \u0430\u0433\u0435\u043d\u0442\u0430 \u0435\u0441\u0442\u044c \u0430\u0431\u043e\u043d\u043f\u043b\u0430\u0442\u0430, \u0430 \u0443 \u0441\u0430\u0439\u0442\u0430 \u043d\u0435\u0442?</summary><p>\u041a\u0430\u0436\u0434\u044b\u0439 \u0434\u0438\u0430\u043b\u043e\u0433 \u0440\u0430\u0441\u0445\u043e\u0434\u0443\u0435\u0442 \u0418\u0418 \u0438 \u0445\u043e\u0441\u0442\u0438\u043d\u0433, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e. \u0421\u0430\u0439\u0442 \u043f\u043e\u0441\u043b\u0435 \u0441\u0434\u0430\u0447\u0438 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0435\u0442.</p></details><details><summary>\u0410 \u0435\u0441\u043b\u0438 \u043c\u043d\u0435 \u043d\u0435 \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f?</summary><p>\u0412\u044b \u0432\u0438\u0434\u0438\u0442\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0434\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u0440\u0430\u0431\u043e\u0442. \u0415\u0441\u043b\u0438 \u043d\u0430 \u044d\u0442\u0430\u043f\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u043d\u0435\u0442, \u0432\u0442\u043e\u0440\u044b\u0435 50 % \u043d\u0435 \u043f\u043b\u0430\u0442\u044f\u0442\u0441\u044f.</p></details><details><summary>\u0412\u044b\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0435 \u043b\u0438 \u0441\u0447\u0435\u0442\u0430?</summary><p>\u0414\u0430. \u0421\u043a\u0430\u0436\u0438\u0442\u0435 \u043f\u0440\u0438 \u0437\u0430\u043a\u0430\u0437\u0435, \u0438 \u043c\u044b \u0437\u0430\u043f\u0440\u043e\u0441\u0438\u043c \u0440\u0435\u043a\u0432\u0438\u0437\u0438\u0442\u044b.</p></details>",
"fin_t":"\u0420\u0430\u0441\u0441\u043a\u0430\u0436\u0438\u0442\u0435 \u043e \u0432\u0430\u0448\u0435\u043c \u0431\u0438\u0437\u043d\u0435\u0441\u0435.",
"fin_d":"\u0414\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043e\u0434\u043d\u043e\u0433\u043e \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f. \u041e\u0442\u0432\u0435\u0447\u0443 \u0432 \u0442\u043e\u0442 \u0436\u0435 \u0434\u0435\u043d\u044c \u0438 \u0441\u043a\u0430\u0436\u0443, \u0447\u0442\u043e \u0432\u0430\u043c \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u2014 \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u043e\u0442\u0432\u0435\u0442 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043f\u043e\u043a\u0430 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043d\u0443\u0436\u043d\u043e.",
